<!-- ========================================================================
     مسئولیت: چیدمان حداقلی ابزارک Niko برای سه عمل QuickLog و خلاصهٔ امن.
     وابستگی‌ها و لایه: Android resource adapter → Widget provider؛ بدون منطق دامنه.
     نکات تغییر و قیود: متن‌ها از منابع Android می‌آیند و دادهٔ خصوصی نمایش داده نمی‌شود.
     ======================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#FFFFFF">
    <TextView android:id="@+id/widget_smoked_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#222222" android:textSize="14sp" />
    <TextView android:id="@+id/widget_resisted_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#222222" android:textSize="14sp" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#222222" android:textSize="14sp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_status_offline" android:textColor="#555555" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_smoked" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_smoked" />
        <Button android:id="@+id/widget_resisted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_resisted" />
        <Button android:id="@+id/widget_craving" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_craving" />
    </LinearLayout>
</LinearLayout>
