<!-- ========================================================================
     مسئولیت: چیدمان حداقلی ابزارک Niko برای سه عمل QuickLog و خلاصهٔ امن.
     وابستگی‌ها و لایه: Android resource adapter → Widget provider؛ بدون منطق دامنه.
     نکات تغییر و قیود: متن‌ها از منابع Android می‌آیند و دادهٔ خصوصی نمایش داده نمی‌شود.
     ======================================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_panel_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/widget_metric_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_smoked" android:textColor="#B8D1DB" android:textSize="11sp" />
            <TextView android:id="@+id/widget_smoked_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#F5FBFF" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:gravity="center" android:orientation="vertical" android:background="@drawable/widget_metric_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_resisted" android:textColor="#B8D1DB" android:textSize="11sp" />
            <TextView android:id="@+id/widget_resisted_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#F5FBFF" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="76dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:background="@drawable/widget_metric_background">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_craving" android:textColor="#B8D1DB" android:textSize="11sp" />
            <TextView android:id="@+id/widget_cravings_today" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#F5FBFF" android:textSize="24sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_loading" android:textColor="#F5FBFF" android:textSize="14sp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_status_offline" android:textColor="#B8D1DB" android:textSize="12sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/widget_smoked" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_smoked" android:textColor="#F5FBFF" android:backgroundTint="#183644" android:drawableTop="@drawable/ic_widget_smoked" android:gravity="center" />
        <Button android:id="@+id/widget_resisted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_resisted" android:textColor="#F5FBFF" android:backgroundTint="#183644" android:drawableTop="@drawable/ic_widget_resisted" android:gravity="center" />
        <Button android:id="@+id/widget_craving" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/widget_craving" android:textColor="#F5FBFF" android:backgroundTint="#183644" android:drawableTop="@drawable/ic_widget_craving" android:gravity="center" />
    </LinearLayout>
</LinearLayout>
