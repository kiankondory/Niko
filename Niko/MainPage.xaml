<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: MainPage.xaml
  مسئولیت: رابط ثبت سریع رخدادهای محلی و نمایش مسیرهای کوتاهِ قابل دسترس.
  وابستگی‌ها و لایه: MAUI presentation → MainViewModel → QuickLogUseCase؛ منطق دامنه یا ذخیره‌سازی مستقیم ندارد.
  نکات تغییر و قیود: ورودی ناوبری ناسالم Battle حذف شده است؛ کارت Craving فقط رخداد محلی ثبت می‌کند و تمام متن‌ها binding محلی‌سازی هستند.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             x:Class="Niko.MainPage"
             x:DataType="vm:MainViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding IsStatusVisible}" Padding="12,10">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsStatusSuccess}" Value="True">
                        <Setter Property="Stroke" Value="{StaticResource Success}" />
                        <Setter Property="StrokeThickness" Value="2" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                    <Image Source="quicklog_success.svg" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding StatusMessage}" Style="{StaticResource FormLabel}" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource HeroCard}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding Title}" Style="{StaticResource HeroTitle}" />
                    <Label Text="{Binding Subtitle}" Style="{StaticResource HeroBody}" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding SmokedTodayText}" Style="{StaticResource HeroTitle}" FontSize="16" />
                            <Label Text="{Binding SmokedLabel}" Style="{StaticResource HeroBody}" FontSize="11" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding ResistedTodayText}" Style="{StaticResource HeroTitle}" FontSize="16" />
                            <Label Text="{Binding ResistedLabel}" Style="{StaticResource HeroBody}" FontSize="11" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label Text="{Binding CravingsTodayText}" Style="{StaticResource HeroTitle}" FontSize="16" />
                            <Label Text="{Binding CravingLabel}" Style="{StaticResource HeroBody}" FontSize="11" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14" SemanticProperties.Description="{Binding SmokedLabel}">
                    <Border Background="#263A4A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="10">
                        <Image Source="quicklog_smoked.svg" HeightRequest="30" WidthRequest="30" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding SmokedLabel}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding SmokedTodayText}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="quicklog_open.svg" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SmokedCommand}" /></Grid.GestureRecognizers>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14" SemanticProperties.Description="{Binding ResistedLabel}">
                    <Border Background="#163D2A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="10">
                        <Image Source="quicklog_resisted.svg" HeightRequest="30" WidthRequest="30" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding ResistedLabel}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding ResistedTodayText}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="quicklog_open.svg" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding ResistedCommand}" /></Grid.GestureRecognizers>
                </Grid>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14" SemanticProperties.Description="{Binding CravingLabel}">
                    <Border Background="#493920" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="10">
                        <Image Source="quicklog_craving.svg" HeightRequest="30" WidthRequest="30" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding CravingLabel}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding CravingsTodayText}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" Source="quicklog_open.svg" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding CravingCommand}" /></Grid.GestureRecognizers>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
