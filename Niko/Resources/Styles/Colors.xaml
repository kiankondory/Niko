<?xml version="1.0" encoding="UTF-8" ?>
<!--
  نام فایل: Colors.xaml
  مسئولیت: تعریف tokenهای رنگی برند Niko برای پوسته‌های روشن و تیره.
  وابستگی‌ها و لایه: MAUI presentation resources؛ توسط Styles و Pageها مصرف می‌شود و هیچ وابستگی به Core ندارد.
  نکات تغییر و قیود: رنگ‌ها برای کنتراست، RTL/LTR و دسترس‌پذیری انتخاب شده‌اند؛ منطق یا متن کاربر در این فایل قرار ندارد.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- رنگ‌های سازگار با template اولیه؛ برای کنترل‌های موجود حفظ شده‌اند. -->
    <Color x:Key="Primary">#26B46A</Color>
    <Color x:Key="PrimaryDark">#35C878</Color>
    <Color x:Key="PrimaryDarkText">#061A12</Color>
    <Color x:Key="Secondary">#D8F6E5</Color>
    <Color x:Key="SecondaryDarkText">#A7EEC4</Color>
    <Color x:Key="Tertiary">#0B6B92</Color>

    <!-- سطوح Light/Dark برند. -->
    <Color x:Key="AppBackgroundLight">#F4F8FA</Color>
    <Color x:Key="AppBackgroundDark">#06111B</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#0B1D2B</Color>
    <Color x:Key="SurfaceElevatedLight">#EDF4F7</Color>
    <Color x:Key="SurfaceElevatedDark">#102737</Color>
    <Color x:Key="HeroLight">#0B5268</Color>
    <Color x:Key="HeroDark">#092638</Color>
    <Color x:Key="TextPrimaryLight">#102333</Color>
    <Color x:Key="TextPrimaryDark">#F3F8FC</Color>
    <Color x:Key="TextSecondaryLight">#5C6E7B</Color>
    <Color x:Key="TextSecondaryDark">#A9BBC7</Color>
    <Color x:Key="BorderLight">#D7E3E9</Color>
    <Color x:Key="BorderDark">#244154</Color>
    <Color x:Key="TrackLight">#DCE8EC</Color>
    <Color x:Key="TrackDark">#1B3C4D</Color>
    <Color x:Key="Success">#25B66A</Color>
    <Color x:Key="Warning">#F2A93B</Color>
    <Color x:Key="Info">#32A9E0</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#26B46A</Color>
    <Color x:Key="MidnightBlue">#102333</Color>
    <Color x:Key="OffBlack">#06111B</Color>

    <Color x:Key="Gray100">#EAF0F3</Color>
    <Color x:Key="Gray200">#D2DDE3</Color>
    <Color x:Key="Gray300">#A9BBC7</Color>
    <Color x:Key="Gray400">#7E93A1</Color>
    <Color x:Key="Gray500">#5C6E7B</Color>
    <Color x:Key="Gray600">#35505F</Color>
    <Color x:Key="Gray900">#102333</Color>
    <Color x:Key="Gray950">#06111B</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
