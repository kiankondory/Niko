<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: SettingsPage.xaml
  مسئولیت: نمایش سازگار با Design System برای مسیر قدیمی تنظیمات؛ داده را به SettingsViewModel متصل می‌کند.
  وابستگی‌ها و لایه: MAUI UI → SettingsViewModel → Core؛ بدون ذخیره‌سازی یا اعتبارسنجی مستقل در صفحه.
  نکات تغییر و قیود: این صفحه رفتار تنظیمات موجود را حفظ می‌کند و برای Light/Dark، RTL/LTR و متن‌های طولانی واکنش‌گراست.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             x:Class="Niko.Pages.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="16">
            <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyMuted}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding CigarettesPerDayLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding CigarettesPerDayText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PricePerCigaretteLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PricePerCigaretteText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PricePerPackLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PricePerPackText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PackSizeLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PackSizeText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding CurrencyLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding CurrencyCode}" /></Border>
                    <Label Text="{Binding QuitDateLabel}" Style="{StaticResource FormLabel}" />
                    <DatePicker Date="{Binding QuitDate}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" />
            <Label Text="{Binding SavingsHint}" Style="{StaticResource BodyMuted}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ThemeTitle}" Style="{StaticResource SectionTitle}" />
                    <Picker ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            ItemDisplayBinding="{Binding DisplayName}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding ReduceMotionLabel}" Style="{StaticResource FormLabel}" />
                        <Label Text="{Binding ReduceMotionDescription}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding ReduceMotion}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
