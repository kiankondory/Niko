<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: CravingBattlePage.xaml
  مسئولیت: ارائهٔ تصویری جریان Battle، شدت، مداخله و تایمر با دادهٔ ViewModel.
  وابستگی‌ها و لایه: MAUI presentation → CravingBattleViewModel → Core use case.
  نکات تغییر و قیود: کارت‌ها فقط وضعیت و commandهای موجود را نمایش می‌دهند؛ هیچ
  منطق ترک، دادهٔ خصوصی یا متن hard-code شدهٔ قابل‌نمایش ندارند.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             xmlns:crav="clr-namespace:Niko.Core.Domain.Craving;assembly=Niko.Core"
             x:Class="Niko.Pages.CravingBattlePage"
             x:DataType="vm:CravingBattleViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">

            <Border Style="{StaticResource HeroCard}" Padding="0" StrokeThickness="0">
                <Grid>
                    <Image Source="niko_battle_scene_v1.png" Aspect="AspectFill" HeightRequest="250" />
                    <VerticalStackLayout Padding="18" VerticalOptions="Start" Spacing="4">
                        <Label Text="{Binding Title}" Style="{StaticResource HeroTitle}" />
                        <Label Text="{Binding SelectIntensityPrompt}" Style="{StaticResource HeroBody}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- انتخاب شدت -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsIntensityPhase}">
                <Label Text="{Binding SelectIntensityPrompt}" Style="{StaticResource SectionTitle}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Button Text="{Binding MildLabel}" Command="{Binding SelectIntensityCommand}"
                            CommandParameter="{x:Static crav:CravingIntensity.Mild}" HeightRequest="112"
                            BackgroundColor="#1C5A48" CornerRadius="20" />
                    <Button Grid.Column="1" Text="{Binding ModerateLabel}" Command="{Binding SelectIntensityCommand}"
                            CommandParameter="{x:Static crav:CravingIntensity.Moderate}" HeightRequest="112"
                            BackgroundColor="#9A6418" CornerRadius="20" />
                    <Button Grid.Column="2" Text="{Binding IntenseLabel}" Command="{Binding SelectIntensityCommand}"
                            CommandParameter="{x:Static crav:CravingIntensity.Intense}" HeightRequest="112"
                            BackgroundColor="#943D46" CornerRadius="20" />
                </Grid>
            </VerticalStackLayout>

            <!-- انتخاب مداخله -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsActionPhase}">
                <Border Style="{StaticResource HeroCard}" IsVisible="{Binding IsCoachSuggestionVisible}" Padding="12">
                    <Label Text="{Binding CoachSuggestionText}" Style="{StaticResource SubHeadline}" />
                </Border>
                <Label Text="{Binding ChooseActionPrompt}" Style="{StaticResource SubHeadline}" />
                <VerticalStackLayout Spacing="12"
                                     BindableLayout.ItemsSource="{Binding Interventions}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:InterventionDisplay">
                            <Border Style="{StaticResource CardBorder}" Padding="14,10">
                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="12" SemanticProperties.Description="{Binding Title}">
                                    <Image Source="{Binding IconSource}" HeightRequest="32" WidthRequest="32" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" Style="{StaticResource FormLabel}" />
                                        <Label Text="{Binding DurationText}" Style="{StaticResource BodyMuted}" />
                                    </VerticalStackLayout>
                                    <Image Grid.Column="2" Source="quicklog_open.svg" HeightRequest="24" WidthRequest="24" VerticalOptions="Center" />
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectActionCommand, Source={RelativeSource AncestorType={x:Type vm:CravingBattleViewModel}}}"
                                                              CommandParameter="{Binding Intervention}" />
                                    </Grid.GestureRecognizers>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- مداخلهٔ فعال + تایمر -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsActivePhase}">
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
                        <Image Source="{Binding CurrentInterventionIconSource}" HeightRequest="48" WidthRequest="48" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding CurrentInterventionTitle}" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding CurrentInterventionGuide}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Border Style="{StaticResource HeroCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding TimerText}" Style="{StaticResource HeroTitle}" FontSize="36" HorizontalTextAlignment="Center" />
                        <ProgressBar Progress="{Binding TimerProgress}" HeightRequest="12" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="{Binding CompleteLabel}" Command="{Binding CompleteCommand}" />
                <Button Text="{Binding ResistLabel}" Command="{Binding ResistCommand}" />
                <Button Text="{Binding ExitLabel}" Command="{Binding ExitCommand}" />
            </VerticalStackLayout>

            <!-- نتیجه (تکمیل/مقاومت/خروج) -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsResultPhase}">
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Headline}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{Binding StartOverLabel}" Command="{Binding StartOverCommand}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
