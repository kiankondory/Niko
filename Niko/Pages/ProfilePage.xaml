<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: ProfilePage.xaml
  مسئولیت: هاب بصری پروفایل، تنظیمات، زبان و Coach با کارت‌های سازگار با دو پوسته.
  وابستگی‌ها و لایه: MAUI UI → SettingsViewModel → Core use cases/stores؛ بدون منطق دامنه یا ذخیره‌سازی مستقیم.
  نکات تغییر و قیود: تمام متن‌ها binding محلی‌سازی هستند، رضایت Coach جدا و قابل لغو می‌ماند، و فرم برای RTL/LTR و متن طولانی انعطاف‌پذیر است.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             x:Class="Niko.Pages.ProfilePage"
             x:DataType="vm:SettingsViewModel"
             Title="">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="{Binding ProfileTitle}" Style="{StaticResource PageTitle}" />
                <Label Text="{Binding StatusMessage}" Style="{StaticResource BodyMuted}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding DisplayNameLabel}" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2">
                        <Entry Text="{Binding DisplayName}" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding Title}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding CigarettesPerDayLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding CigarettesPerDayText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PricePerCigaretteLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PricePerCigaretteText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PricePerPackLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PricePerPackText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding PackSizeLabel}" Style="{StaticResource FormLabel}" />
                    <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0" Padding="10,2"><Entry Text="{Binding PackSizeText}" Keyboard="Numeric" /></Border>
                    <Label Text="{Binding CurrencyLabel}" Style="{StaticResource FormLabel}" />
                    <Picker ItemsSource="{Binding CurrencyOptions}"
                            SelectedItem="{Binding SelectedCurrency}"
                            ItemDisplayBinding="{Binding DisplayName}" />
                    <Label Text="{Binding QuitDateLabel}" Style="{StaticResource FormLabel}" />
                    <DatePicker Date="{Binding QuitDate}" />
                    <Label Text="{Binding SavingsHint}" Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding LanguageLabel}" Style="{StaticResource SectionTitle}" />
                    <Picker ItemsSource="{Binding LanguageOptions}"
                            SelectedItem="{Binding SelectedLanguage}"
                            ItemDisplayBinding="{Binding DisplayLabel}" />
                    <Label Text="{Binding LanguageFallbackLabel}"
                           IsVisible="{Binding IsLanguageFallback}"
                           Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding ThemeTitle}" Style="{StaticResource SectionTitle}" />
                    <Picker ItemsSource="{Binding ThemeOptions}"
                            SelectedItem="{Binding SelectedTheme}"
                            ItemDisplayBinding="{Binding DisplayName}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding ReduceMotionLabel}" Style="{StaticResource FormLabel}" />
                        <Label Text="{Binding ReduceMotionDescription}" Style="{StaticResource BodyMuted}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding ReduceMotion}" />
                </Grid>
            </Border>

            <Button Text="{Binding SaveLabel}" Command="{Binding SaveCommand}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,96" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding CoachTitle}" Style="{StaticResource SectionTitle}" />
                            <Label Text="{Binding CoachPrivacyNote}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="niko_coach_v1.png" Aspect="AspectFit" HeightRequest="96" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding CoachDisabledText}" IsVisible="{Binding IsCoachDisabled}" Style="{StaticResource BodyMuted}" />
                            <Label Text="{Binding CoachEnabledText}" IsVisible="{Binding IsCoachEnabled}" Style="{StaticResource BodyMuted}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsCoachEnabled}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding CoachAllowProgressLabel}" Style="{StaticResource FormLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AllowAggregatedProgress}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding CoachAllowCravingLabel}" Style="{StaticResource FormLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AllowCravingContext}" />
                    </Grid>
                    <Button Text="{Binding CoachClearLabel}" Command="{Binding ClearCoachCommand}" Style="{StaticResource OutlineButton}" />
                    <Label Text="{Binding CoachStatus}" Style="{StaticResource BodyMuted}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding CoachExternalTitle}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding CoachExternalNote}" Style="{StaticResource BodyMuted}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Text="{Binding CoachExternalConsentLabel}" Style="{StaticResource FormLabel}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding AllowExternalProvider}" IsEnabled="False">
                            <Switch.Triggers>
                                <DataTrigger TargetType="Switch" Binding="{Binding IsExternalProviderAvailable}" Value="True">
                                    <Setter Property="IsEnabled" Value="True" />
                                </DataTrigger>
                            </Switch.Triggers>
                        </Switch>
                    </Grid>
                    <Label Text="{Binding CoachExternalStatus}" Style="{StaticResource BodyMuted}" />
                    <Button Text="{Binding CoachExternalRevokeLabel}" Command="{Binding RevokeExternalCommand}" Style="{StaticResource OutlineButton}" />
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{Binding NotificationsLabel}" Command="{Binding NotificationsCommand}" Style="{StaticResource OutlineButton}" />
                <Button Grid.Column="1" Text="{Binding PrivacyDataLabel}" Command="{Binding PrivacyDataCommand}" Style="{StaticResource OutlineButton}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
