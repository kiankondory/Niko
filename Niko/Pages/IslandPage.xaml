<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: IslandPage.xaml
  مسئولیت: نمایش تصویری پیشرفت و میل‌استون‌های واقعی کاربر در نمای Island.
  وابستگی‌ها و لایه: MAUI page → IslandViewModel؛ محاسبه و ذخیره‌سازی فقط در Core است.
  نکات تغییر و قیود: تصویر محلی است؛ هیچ رویداد خام، XP یا جزئیات خصوصی نمایش داده نمی‌شود.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             x:Class="Niko.Pages.IslandPage"
             x:DataType="vm:IslandViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,28" Spacing="16">
            <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
            <Label Text="{Binding Subtitle}" Style="{StaticResource BodyMuted}" />
            <Border Style="{StaticResource HeroCard}" Padding="8">
                <Image Source="niko_island_v1.png" Aspect="AspectFit" HeightRequest="300" />
            </Border>
            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" />
            <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="14">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding StreakText}" Style="{StaticResource MetricValue}" />
                            <Label Text="{Binding CurrentStreakLabel}" Style="{StaticResource MetricLabel}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding NextMilestoneText}" Style="{StaticResource MetricValue}" />
                            <Label Text="{Binding NextMilestoneLabel}" Style="{StaticResource MetricLabel}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ProgressLabel}" Style="{StaticResource SectionTitle}" />
                        <ProgressBar Progress="{Binding Progress}" HeightRequest="10" />
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Milestones}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:IslandMilestoneDisplay">
                            <Border Style="{StaticResource CardBorder}" Padding="14,10">
                                <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="10">
                                    <Label Text="{Binding Icon}" FontSize="22" VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="{Binding DaysText}" Style="{StaticResource FormLabel}" VerticalOptions="Center" />
                                    <Label Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource BodyMuted}" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
            <Label Text="{Binding EmptyText}" IsVisible="{Binding IsEmpty}" Style="{StaticResource BodyMuted}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
