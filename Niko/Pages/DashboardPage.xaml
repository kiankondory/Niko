<?xml version="1.0" encoding="utf-8" ?>
<!--
  نام فایل: DashboardPage.xaml
  مسئولیت: ارائهٔ بصری پیشرفت، فعالیت و تحلیل محرک با Design System جدید Niko.
  وابستگی‌ها و لایه: MAUI page → DashboardViewModel؛ داده و محاسبات فقط از Core می‌آیند.
  نکات تغییر و قیود: هیچ دادهٔ خام یا منطق دامنه در UI نیست؛ همهٔ متن‌ها binding محلی‌سازی و همهٔ سطوح با Light/Dark سازگارند.
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Niko.ViewModels"
             x:Class="Niko.Pages.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="{Binding Title}">

    <Grid Padding="16,12">
        <ScrollView>
            <VerticalStackLayout Spacing="16" Padding="0,0,0,76">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center" />

                <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="16">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding DashboardGreeting}" Style="{StaticResource BodyMuted}" />
                        <Label Text="{Binding Title}" Style="{StaticResource PageTitle}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource HeroCard}">
                        <Grid ColumnDefinitions="*,130" ColumnSpacing="4" MinimumHeightRequest="172">
                            <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="{Binding DashboardHeroTitle}" Style="{StaticResource HeroTitle}" />
                                <Label Text="{Binding CurrentStreakText}" Style="{StaticResource HeroTitle}" FontSize="20" />
                                <Label Text="{Binding DashboardHeroBody}" Style="{StaticResource HeroBody}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1"
                                   Source="niko_coach_hero.png"
                                   Aspect="AspectFit"
                                   HeightRequest="162"
                                   HorizontalOptions="End"
                                   VerticalOptions="End" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="6">
                                <Image Source="progress_leaf.svg" HeightRequest="38" WidthRequest="38" HorizontalOptions="Start" />
                                <Label Text="{Binding ResistedText}" Style="{StaticResource MetricValue}" />
                                <Label Text="{Binding ResistedLabel}" Style="{StaticResource MetricLabel}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="6">
                                <Image Source="progress_savings.svg" HeightRequest="38" WidthRequest="38" HorizontalOptions="Start" />
                                <Label Text="{Binding SavingsText}" Style="{StaticResource MetricValue}" FontSize="18" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DashboardSavings}" Style="{StaticResource MetricLabel}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                            <VerticalStackLayout Spacing="6">
                                <Image Source="progress_time.svg" HeightRequest="38" WidthRequest="38" HorizontalOptions="Start" />
                                <Label Text="{Binding CurrentStreakText}" Style="{StaticResource MetricValue}" FontSize="18" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DashboardCurrentStreak}" Style="{StaticResource MetricLabel}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="{Binding DashboardActivity}" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding SmokedText}" Style="{StaticResource MetricValue}" />
                                    <Label Text="{Binding SmokedLabel}" Style="{StaticResource MetricLabel}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="{Binding ResistedText}" Style="{StaticResource MetricValue}" />
                                    <Label Text="{Binding ResistedLabel}" Style="{StaticResource MetricLabel}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="{Binding CravingsText}" Style="{StaticResource MetricValue}" />
                                    <Label Text="{Binding CravingsLabel}" Style="{StaticResource MetricLabel}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding RecoveryTitle}" Style="{StaticResource SectionTitle}" />
                            <Grid ColumnDefinitions="94,*" ColumnSpacing="10" IsVisible="{Binding IsRecoveryAvailable}">
                                <Image Source="{Binding RecoveryImageSource}"
                                       HeightRequest="136"
                                       WidthRequest="94"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding RecoveryStageTitle}" Style="{StaticResource FormLabel}" />
                                    <Label Text="{Binding RecoveryProgressLabel}" Style="{StaticResource BodyMuted}" />
                                    <ProgressBar x:Name="RecoveryProgressBar" Progress="{Binding RecoveryProgress}" HeightRequest="10" />
                                    <Label Text="{Binding RecoveryStageDescription}" Style="{StaticResource BodyMuted}" />
                                    <Label Text="{Binding RecoveryNextStageText}" Style="{StaticResource BodyMuted}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding RecoveryUnavailableText}" Style="{StaticResource BodyMuted}" IsVisible="{Binding IsRecoveryUnavailable}" />
                            <Label Text="{Binding RecoveryDisclaimer}" Style="{StaticResource BodyMuted}" FontSize="11" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsTriggerAnalysisAvailable}">
                        <Label Text="{Binding TriggerAnalysisTitle}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="10">
                                <Button Text="{Binding TriggerAnalysisToggleText}" Command="{Binding ToggleTriggerAnalysisCommand}" />
                                <Label Text="{Binding TriggerAnalysisPrivacyNote}" Style="{StaticResource BodyMuted}" />
                                <Label Text="{Binding TriggerAnalysisMinimumDataText}" Style="{StaticResource BodyMuted}" />
                                <Label Text="{Binding TriggerAnalysisDisabledText}" Style="{StaticResource BodyMuted}" IsVisible="{Binding IsTriggerAnalysisDisabled}" />
                                <Label Text="{Binding TriggerAnalysisInsufficientDataText}" Style="{StaticResource BodyMuted}" IsVisible="{Binding IsTriggerAnalysisInsufficientData}" />
                                <Label Text="{Binding TriggerAnalysisEmptyText}" Style="{StaticResource BodyMuted}" IsVisible="{Binding IsTriggerAnalysisEmpty}" />
                                <Label Text="{Binding TriggerAnalysisErrorText}" Style="{StaticResource BodyMuted}" IsVisible="{Binding IsTriggerAnalysisError}" />
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasTriggerInsights}" BindableLayout.ItemsSource="{Binding TriggerInsights}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TriggerInsightDisplay">
                                            <Border Style="{StaticResource MetricCard}" MinimumHeightRequest="0">
                                                <VerticalStackLayout Spacing="4">
                                                    <Label Text="{Binding Text}" Style="{StaticResource BodyMuted}" />
                                                    <Label Text="{Binding ApproximateText}" Style="{StaticResource MetricLabel}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <Label Text="{Binding TriggerAnalysisDisclaimer}" Style="{StaticResource BodyMuted}" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border Style="{StaticResource HeroCard}" IsVisible="{Binding IsEmpty}" Padding="22">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label Text="{Binding DashboardEmptyText}" Style="{StaticResource HeroTitle}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding RecoveryUnavailableText}" Style="{StaticResource HeroBody}" HorizontalTextAlignment="Center" />
                        <Button Text="{Binding StartLoggingText}" Command="{Binding StartLoggingCommand}" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button Text="{Binding RefreshText}"
                Command="{Binding RefreshCommand}"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,4,4" />
    </Grid>
</ContentPage>
